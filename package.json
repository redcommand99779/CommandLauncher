{
  "name": "command-launcher",
  "version": "0.2.0",
  "private": true,
  "description": "Command Launcher - Minecraft Launcher",
  "author": "redcommand99779",
  "main": "src/main/main.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "electron": "electron .",
    "dev": "concurrently -k \"npm:start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "adm-zip": "^0.5.18",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.2.0",
    "minecraft-launcher-core": "^3.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "css-loader": "^6.11.0",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  },
  "build": {
    "appId": "com.commandlauncher.app",
    "productName": "Command Launcher",
    "icon": "assets/icon.png",
    "files": [
      "build/**/*",
      "src/main/**/*",
      "src/main/.env",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "redcommand99779",
      "repo": "CommandLauncher"
    }
  }
}
